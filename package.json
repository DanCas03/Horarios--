{
	"name": "horaios",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"lucide-react": "^0.546.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.3",
			"react-dom": "^19.2.3",
			"sonner": "^2.0.5",
			"@prisma/client": "6.19.0",
			"better-auth": "1.6.9",
			"@types/react": "^19.2.10",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.1.18"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"postinstall": "turbo db:generate",
		"dev:web": "turbo run dev -F web",
		"db:push": "turbo run db:push -F @horaios/db",
		"db:studio": "turbo run db:studio -F @horaios/db",
		"db:generate": "turbo run db:generate -F @horaios/db",
		"db:migrate": "turbo run db:migrate -F @horaios/db",
		"check": "ultracite check",
		"fix": "ultracite fix"
	},
	"dependencies": {
		"@horaios/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@horaios/config": "workspace:*",
		"@types/node": "^22.13.14",
		"turbo": "^2.8.12",
		"typescript": "catalog:",
		"ultracite": "7.9.2"
	},
	"packageManager": "bun@1.3.14"
}
