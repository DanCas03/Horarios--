{
	"name": "horarios",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"lucide-react": "^0.546.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.3",
			"react-dom": "^19.2.3",
			"sonner": "^2.0.5",
			"@prisma/client": "6.19.0",
			"better-auth": "1.6.9",
			"@types/react": "^19.2.10",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.1.18"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"postinstall": "turbo db:generate",
		"dev:web": "turbo -F web dev",
		"db:push": "turbo -F @horarios/db db:push",
		"db:studio": "turbo -F @horarios/db db:studio",
		"db:generate": "turbo -F @horarios/db db:generate",
		"db:migrate": "turbo -F @horarios/db db:migrate",
		"check": "ultracite check",
		"fix": "ultracite fix"
	},
	"dependencies": {
		"@horarios/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@horarios/config": "workspace:*",
		"@types/node": "^22.13.14",
		"turbo": "^2.8.12",
		"typescript": "catalog:",
		"ultracite": "7.8.3"
	},
	"packageManager": "bun@1.3.14"
}
